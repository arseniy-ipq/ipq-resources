---
const updated = '2026-08-18';
import Base from '../layouts/Base.astro';
const title = 'Editorial Standards: How We Source, Check and Correct These Guides | IPQmedia';
const description =
  'The sourcing rules behind the IPQ Field Guide, how our first-party ad account data is built, and a dated log of every correction we have made to a published page.';
const site = 'https://resources.ipqmedia.com';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Editorial standards',
  description,
  url: `${site}/editorial-standards`,
  dateModified: updated,
  publisher: {
    '@type': 'Organization',
    name: 'IPQmedia',
    url: 'https://ipqmedia.com',
    logo: { '@type': 'ImageObject', url: `${site}/ipqmedia-logo.png` },
  },
